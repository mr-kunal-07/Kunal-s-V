rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{memoryId}/{fileName} {
      function owner() { return request.auth != null && request.auth.uid == uid && uid == 'TBuHUAFGhjXCjRVPU1nA3DKIBtk2'; }
      allow read, delete: if owner();
      allow create: if owner() && request.resource.size <= 104857600;
      allow update: if false;
    }
  }
}

